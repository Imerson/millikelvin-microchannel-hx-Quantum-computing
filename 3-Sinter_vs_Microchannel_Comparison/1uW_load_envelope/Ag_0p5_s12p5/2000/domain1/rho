FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "2000/domain1";
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 145;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 145;
    }
    outlet
    {
        type            calculated;
        value           uniform 145;
    }
    domain1_to_solid_wall
    {
        type            calculated;
        value           uniform 145;
    }
}


