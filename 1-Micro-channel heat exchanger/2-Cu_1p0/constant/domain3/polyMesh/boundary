3
(
    inlet
    {
        type            patch;
        nFaces          400;
        startFace       69200;
    }
    outlet
    {
        type            patch;
        nFaces          400;
        startFace       69600;
    }
    domain3_to_solid_wall
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          4800;
        startFace       70000;
        sampleMode      nearestPatchFace;
        sampleRegion    solid_wall;
        samplePatch     solid_wall_to_domain3;
    }
)

